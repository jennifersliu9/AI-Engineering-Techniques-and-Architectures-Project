# Copy this file to .env and fill in values locally.
# Never commit .env or real API keys.

# Required only when HARBORLINE_ANSWER_MODE=llm
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Azure / compatible endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1

# Reproducibility
HARBORLINE_SEED=42

# Retrieval / chunking (deterministic; no random split)
HARBORLINE_CHUNK_SIZE=900
HARBORLINE_CHUNK_OVERLAP=120
HARBORLINE_TOP_K=5

# faiss (default, local MiniLM embeddings) or tfidf (no model download)
HARBORLINE_RETRIEVE_BACKEND=faiss
HARBORLINE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# answer mode: retrieve (default, no API key) or llm
HARBORLINE_ANSWER_MODE=retrieve
